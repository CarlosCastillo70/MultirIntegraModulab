<?xml version="1.0" encoding="utf-8"?>
<!-- 
  FITXER D'EXEMPLE DE CONFIGURACIÓ
  ==================================
  Aquest és un fitxer d'exemple. Per utilitzar-lo:
  1. Copia aquest fitxer a "App.config"
  2. Modifica els valors segons el teu entorn
  3. NO commitejis App.config amb credencials reals al control de versions
-->
<configuration>
  <configSections>
    <section name="applicationSettings" type="System.Configuration.ApplicationSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
  </configSections>

  <!-- Connection Strings -->
  <connectionStrings>
    <!-- Oracle Modulab Connection -->
    <!-- IMPORTANT: Substitueix amb les teves credencials -->
    <add name="OracleModulab"
         connectionString="Data source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL = TCP)(HOST = [TU_HOST])(PORT = 1522))) (CONNECT_DATA = (SERVICE_NAME = [TU_SERVICE])));User Id=[TU_USUARI];Password=[TU_PASSWORD];"
         providerName="Oracle.ManagedDataAccess.Client" />

    <!-- MySQL MultiR Connection -->
    <!-- IMPORTANT: Substitueix amb les teves credencials -->
    <add name="MySqlMultiR"
         connectionString="Server=[TU_SERVER];Database=[TU_DATABASE];Uid=[TU_USUARI];Pwd=[TU_PASSWORD];"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>

  <!-- Application Settings -->
  <appSettings>
    <!-- ============================================ -->
    <!-- CONFIGURACIÓ DE CÀRREGA DE DADES -->
    <!-- ============================================ -->
    
    <!-- Dies enrere per carregar resultats de mostres -->
    <add key="DiesEndarreraCarrega" value="2" />
    
    <!-- Límit de resultats per proves (0 = il·limitat) -->
    <!-- En producció, posar a 0 -->
    <add key="LimitResultatsProves" value="50" />
    
    <!-- Indica si l'aplicació s'executa en producció -->
    <!-- true = Sense límits, false = Amb límits de proves -->
    <add key="EntornProduccion" value="false" />

    <!-- ============================================ -->
    <!-- CONFIGURACIÓ DE LOGGING -->
    <!-- ============================================ -->
    
    <!-- Directori on es guardaran els logs -->
    <add key="LogDirectory" value="Logs" />
    
    <!-- Nivell de logging: Debug, Info, Warning, Error -->
    <add key="LogLevel" value="Info" />

    <!-- ============================================ -->
    <!-- CONFIGURACIÓ D'EMAIL -->
    <!-- ============================================ -->
    
    <!-- Enviar email amb log al finalitzar -->
    <add key="EnviarEmailLog" value="true" />
    
    <!-- Servidor SMTP -->
    <add key="SmtpServer" value="smtp.exemple.com" />
    
    <!-- Port SMTP (normalment 587 per TLS o 465 per SSL) -->
    <add key="SmtpPort" value="587" />
    
    <!-- Usuari SMTP -->
    <add key="SmtpUsuari" value="usuari@exemple.com" />
    
    <!-- Password SMTP -->
    <add key="SmtpPassword" value="[TU_PASSWORD_SMTP]" />
    
    <!-- Usar SSL/TLS -->
    <add key="SmtpUsarSSL" value="true" />
    
    <!-- Email remitent (From) -->
    <add key="EmailFrom" value="multir@exemple.com" />
    
    <!-- Emails destinataris (separats per ;) -->
    <add key="EmailsDestinataris" value="admin1@exemple.com;admin2@exemple.com" />
    
    <!-- Enviar email només si hi ha errors -->
    <add key="EmailNomesEnErrors" value="false" />

    <!-- ============================================ -->
    <!-- CONFIGURACIÓ DE CACHE -->
    <!-- ============================================ -->
    
    <!-- Minuts de vigència de la cache de microorganismes -->
    <add key="MinutsVigenciaCache" value="30" />

    <!-- ============================================ -->
    <!-- CONFIGURACIÓ DE MANTENIMENT -->
    <!-- ============================================ -->
    
    <!-- Dies de retenció de l'historial de mostres -->
    <add key="DiesRetencioHistorial" value="90" />

    <!-- ============================================ -->
    <!-- CONFIGURACIÓ DE PROCESSAMENT -->
    <!-- ============================================ -->
    
    <!-- Processar mostres en paral·lel (experimental) -->
    <add key="ProcessarMostresEnParalel" value="false" />
    
    <!-- Màxim grau de paral·lelisme si està activat -->
    <add key="MaxGrauParalelisme" value="4" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Binding redirects si són necessaris -->
    </assemblyBinding>
  </runtime>
</configuration>
