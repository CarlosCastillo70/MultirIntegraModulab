<?xml version="1.0" encoding="utf-8"?>
<!-- 
  FITXER D'EXEMPLE DE CONFIGURACI�
  ==================================
  Aquest �s un fitxer d'exemple. Per utilitzar-lo:
  1. Copia aquest fitxer a "App.config"
  2. Modifica els valors segons el teu entorn
  3. NO commitejis App.config amb credencials reals al control de versions
-->
<configuration>
  <configSections>
    <section name="applicationSettings" type="System.Configuration.ApplicationSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
  </configSections>

  <!-- Connection Strings -->
  <connectionStrings>
    <!-- Oracle Modulab Connection -->
    <!-- IMPORTANT: Substitueix amb les teves credencials -->
    <add name="OracleModulab"
         connectionString="Data source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL = TCP)(HOST = [TU_HOST])(PORT = 1522))) (CONNECT_DATA = (SERVICE_NAME = [TU_SERVICE])));User Id=[TU_USUARI];Password=[TU_PASSWORD];"
         providerName="Oracle.ManagedDataAccess.Client" />

    <!-- MySQL MultiR Connection -->
    <!-- IMPORTANT: Substitueix amb les teves credencials -->
    <add name="MySqlMultiR"
         connectionString="Server=[TU_SERVER];Database=[TU_DATABASE];Uid=[TU_USUARI];Pwd=[TU_PASSWORD];"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>

  <!-- Application Settings -->
  <appSettings>
    <!-- ============================================ -->
    <!-- CONFIGURACI� DE C�RREGA DE DADES -->
    <!-- ============================================ -->
    
    <!-- Dies enrere per carregar resultats de mostres -->
    <add key="DiesEndarreraCarrega" value="1" />
    
    <!-- L�mit de resultats per proves (0 = il�limitat) -->
    <!-- En producci�, posar a 0 -->
    <add key="LimitResultatsProves" value="50" />
    
    <!-- Indica si l'aplicaci� s'executa en producci� -->
    <!-- true = Sense l�mits, false = Amb l�mits de proves -->
    <add key="EntornProduccion" value="false" />

    <!-- ============================================ -->
    <!-- CONFIGURACI� DE LOGGING -->
    <!-- ============================================ -->
    
    <!-- Directori on es guardaran els logs -->
    <add key="LogDirectory" value="Logs" />
    
    <!-- Nivell de logging: Debug, Info, Warning, Error -->
    <add key="LogLevel" value="Info" />

    <!-- ============================================ -->
    <!-- CONFIGURACI� DE CACHE -->
    <!-- ============================================ -->
    
    <!-- Minuts de vig�ncia de la cache de microorganismes -->
    <add key="MinutsVigenciaCache" value="30" />

    <!-- ============================================ -->
    <!-- CONFIGURACI� DE MANTENIMENT -->
    <!-- ============================================ -->
    
    <!-- Dies de retenci� de l'historial de mostres -->
    <add key="DiesRetencioHistorial" value="90" />

    <!-- ============================================ -->
    <!-- CONFIGURACI� DE PROCESSAMENT -->
    <!-- ============================================ -->
    
    <!-- Processar mostres en paral�lel (experimental) -->
    <add key="ProcessarMostresEnParalel" value="false" />
    
    <!-- M�xim grau de paral�lelisme si est� activat -->
    <add key="MaxGrauParalelisme" value="4" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Binding redirects si s�n necessaris -->
    </assemblyBinding>
  </runtime>
</configuration>
