<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="applicationSettings" type="System.Configuration.ApplicationSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
	</configSections>

	<!-- Application Settings -->
	<appSettings>
		<!-- ============================================ -->
		<!-- CONFIGURACIÓ D'ENTORN -->
		<!-- ============================================ -->

		<!-- IMPORTANT: Canviar a "Produccio" abans de desplegar -->
		<add key="Entorn" value="Preproduccio" />

		<!-- ============================================ -->
		<!-- CONFIGURACIÓ DE CÀRREGA DE DADES -->
		<!-- PRIORITAT D'EXECUCIÓ: 1. Incremental, 2. Incremental Últim Canvi, 3. Dies Enrere, 4. Rang de Dates -->
		<!-- Només s'executarà el PRIMER tipus activat (true) -->
		<!-- ============================================ -->

		<!-- ──────────────────────────────────────────── -->
		<!-- TIPUS 1A: CÀRREGA INCREMENTAL SEGONS D. RESULTAT I D. VALIDACIÓ (Prioritat Alta) -->
		<!-- ──────────────────────────────────────────── -->
		<!-- Carrega només les mostres noves basant-se en les darreres dates processades -->
		<!-- PRODUCCIÓ: Recomanat per optimitzar el rendiment i evitar duplicats -->
		<add key="CarregaIncremental_Activa" value="false" />

		<!-- Dies de revisió de seguretat (finestra temporal per validacions tardanes) -->
		<!-- Les mostres dins d'aquest període també es revisaran per detectar canvis -->
		<add key="CarregaIncremental_DiesRevisioSeguretat" value="7" />

		<!-- ──────────────────────────────────────────── -->
		<!-- TIPUS 1B: CÀRREGA INCREMENTAL SEGONS ÚLTIM CANVI (Prioritat Mitjana) -->
		<!-- ──────────────────────────────────────────── -->
		<!-- Carrega mostres noves basant-se en la data de l'últim canvi (RESULTLASTCHANGE) -->
		<!-- PRODUCCIÓ: Més precís que la carrega incremental estàndard per detectar canvis recents -->
		<add key="CarregaIncremental_UltimCanvi_Activa" value="true" />

		<!-- Dies de revisió de seguretat (finestra temporal per validacions tardanes) -->
		<!-- Per a la primera execució: carrega els últims N dies -->
		<add key="CarregaIncremental_UltimCanvi_DiesRevisioSeguretat" value="7" />

		<!-- Nombre de dies enrere per capturar canvis (window temporal) -->
		<!-- PRODUCCIÓ: Recomanat 50 dies per cobrir els últims canvis -->
		<add key="CarregaIncremental_UltimCanvi_DiasEnRe" value="5" />

		<!-- ──────────────────────────────────────────── -->
		<!-- TIPUS 2: CÀRREGA PER DIES ENRERE (Prioritat Mitjana-Alta) -->
		<!-- ──────────────────────────────────────────── -->
		<!-- Carrega mostres dels últims N dies cap enrere des d'avui -->
		<!-- Útil per: Proves, càrregues inicials, reprocesaments recents -->
		<add key="CarregaDiesEnrere_Activa" value="false" />

		<!-- Nombre de dies enrere per carregar resultats de mostres -->
		<!-- PRODUCCIÓ: Recomanat 1-2 dies per evitar sobrecàrrega -->
		<!-- PROVES: Pot augmentar-se per carregar més històric -->
		<add key="CarregaDiesEnrere_NombreDies" value="20" />

		<!-- ──────────────────────────────────────────── -->
		<!-- TIPUS 3: CÀRREGA PER RANG DE DATES (Prioritat Baixa) -->
		<!-- ──────────────────────────────────────────── -->
		<!-- Carrega mostres d'un període específic entre dues dates -->
		<!-- Útil per: Reprocesaments històrics, correccions de dades, anàlisis retrospectives -->
		<add key="CarregaRangDates_Activa" value="false" />

		<!-- Data d'inici del rang (format: dd/MM/yyyy) -->
		<!-- Exemple: 01/01/2024 -->
		<add key="CarregaRangDates_DataInici" value="26/01/2026" />

		<!-- Data de fi del rang (format: dd/MM/yyyy) -->
		<!-- Exemple: 31/01/2024 -->
		<add key="CarregaRangDates_DataFi" value="30/01/2026" />

		<!-- ──────────────────────────────────────────── -->
		<!-- PARÀMETRES COMUNS PER A TOTS ELS TIPUS DE CÀRREGA -->
		<!-- ──────────────────────────────────────────── -->

		<!-- Límit de resultats per proves (0 = il·limitat) -->
		<!-- PRODUCCIÓ: Mantenir 0 per processar totes les mostres -->
		<!-- PROVES: Pot limitar-se per fer proves ràpides (ex: 100, 500, 1000) -->
		<add key="LimitResultatsProves" value="0" />

		<!-- ============================================ -->
		<!-- CONFIGURACIÓ DE FILTRATGE DE MOSTRES -->
		<!-- ============================================ -->

		<!-- Etiquetes de mostra a processar (separades per ;) - OPCIONAL
         Exemple: 446442973323;452163644323     402942881383
         PRODUCCIÓ: Deixar BUIT per processar totes les mostres -->
		<add key="EtiquetesMostresAProcessar" value="" />


		<!-- ============================================ -->
		<!-- CONFIGURACIÓ DE WEBSERVICES -->
		<!-- ============================================ -->

		<!-- URL del WebService de pacients SAP - Producció -->
		<add key="WebServicePacients_Produccio" value="http://10.80.160.178/flamma/ws/consultaPacient/consultaPacient.php" />

		<!-- URL del WebService de pacients SAP - Preproducció -->
		<add key="WebServicePacients_Preproduccio" value="http://10.80.160.179/flamma/ws/consultaPacient/consultaPacient.php" />

		<!-- Timeout per WebServices (en segons) -->
		<add key="WebServiceTimeout" value="30" />

		<!-- ============================================ -->
		<!-- CONFIGURACIÓ DE LOGGING -->
		<!-- ============================================ -->

		<!-- Ruta del fitxer de log (suporta format amb data i hora: {0:yyyy-MM-dd_HH-mm-ss} i entorn: {1}) -->
		<add key="RutaFitxerLog" value="Logs\multir{0:yyyy-MM-dd_HH-mm-ss}_{1}.log" />

		<!-- Nivell mínim de log Serilog: Verbose, Debug, Information, Warning, Error, Fatal -->
		<!-- PRODUCCIÓ: Recomanat "Information" o "Warning" -->
		<add key="Serilog:MinimumLevel" value="Information" />

		<!-- ============================================ -->
		<!-- CONFIGURACIÓ DE SEQ (Monitorització de Logs) -->
		<!-- ============================================ -->

		<!-- Activar enviament de logs a Seq per monitorització en temps real -->
		<!-- PRODUCCIÓ: "true" per tenir observabilitat completa -->
		<!-- DESENVOLUPAMENT: "true" per debugging avançat -->
		<!-- NOTA: Si Seq no està disponible, els logs continuaran funcionant a fitxer i consola -->
		<add key="Seq:Actiu" value="true" />

		<!-- URL del servidor Seq -->
		<!-- Local: http://localhost:5341 -->
		<!-- Docker: http://localhost:5341 (executar: docker run -d [paràmetres] -p 5341:80 datalust/seq:latest) -->
		<!-- Azure/AWS: http://seq.yourdomain.com -->
		<add key="Seq:ServerUrl" value="http://localhost:5341" />

		<!-- API Key de Seq (opcional, només si Seq requereix autenticació) -->
		<!-- Deixar buit si no cal autenticació -->
		<add key="Seq:ApiKey" value="" />

		<!-- Directori on es guardaran els logs LEGACY (mantenir per compatibilitat) -->
		<add key="LogDirectory" value="Logs" />

		<!-- Nivell de logging LEGACY: Debug, Info, Warning, Error -->
		<add key="LogLevel" value="Info" />

		<!-- ============================================ -->
		<!-- CONFIGURACIÓ D'EMAIL -->
		<!-- ============================================ -->

		<!-- Enviar email amb log al finalitzar -->
		<add key="EnviarEmailLog" value="true" />

		<!-- Servidor SMTP -->
		<add key="SmtpServer" value="smtp.trueta.intranet" />

		<!-- Port SMTP (normalment 587 per TLS, 465 per SSL, 25 per connexions locals sense encriptació) -->
		<add key="SmtpPort" value="25" />

		<!-- Usuari SMTP (OPCIONAL: deixar buit o amb valor d'exemple si el servidor no requereix autenticació) -->
		<add key="SmtpUsuari" value="" />

		<!-- Password SMTP (OPCIONAL: deixar buit o amb valor d'exemple si el servidor no requereix autenticació) -->
		<add key="SmtpPassword" value="" />

		<!-- Usar SSL/TLS (false per servidors interns que no utilitzen encriptació) -->
		<add key="SmtpUsarSSL" value="false" />

		<!-- Email remitent (From) -->
		<add key="EmailFrom" value="ccastillo.ics@gencat.cat" />

		<!-- Emails destinataris (separats per ;) -->
		<add key="EmailsDestinataris" value="carloscastillollucia@gmail.com" />

		<!-- Enviar email només si hi ha errors -->
		<!-- PRODUCCIÓ: false per rebre sempre resum d'execució -->
		<add key="EmailNomesEnErrors" value="false" />

		<!-- ============================================ -->
		<!-- CONFIGURACIÓ DE CACHE -->
		<!-- ============================================ -->

		<!-- Minuts de vigència de la cache de microorganismes -->
		<add key="MinutsVigenciaCache" value="60" />

		<!-- ============================================ -->
		<!-- CONFIGURACIÓ DE MANTENIMENT -->
		<!-- ============================================ -->

		<!-- Dies de retenció de l'historial de mostres -->
		<add key="DiesRetencioHistorial" value="90" />

		<!-- ============================================ -->
		<!-- CONFIGURACIÓ DE PROCESSAMENT -->
		<!-- ============================================ -->

		<!-- Processar mostres en paral·lel (experimental) -->
		<!-- PRODUCCIÓ: Mantenir false fins validar rendiment -->
		<add key="ProcessarMostresEnParalel" value="false" />

		<!-- Màxim grau de paral·lelisme si està activat -->
		<add key="MaxGrauParalelisme" value="4" />
	</appSettings>



	<!-- Connection Strings -->
	<connectionStrings>
		<!-- ============================================ -->
		<!-- ENTORN PRODUCCIÓ -->
		<!-- ============================================ -->

		<!-- Oracle Modulab Connection - Producció -->
		<!-- VERIFICAR: Credencials correctes de producció -->
		<add name="OracleModulab_Produccio"
			 connectionString="Data source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL = TCP)(HOST = 146.219.109.73)(PORT = 1521))) (CONNECT_DATA = (SERVICE_NAME = mgold)));User Id=covid;Password=t6k8*_NQueB6;"
			 providerName="Oracle.ManagedDataAccess.Client" />

		<!-- MySQL MultiR Connection - Producció -->
		<!-- VERIFICAR: Base de dades correcta (marsa, NO marsa_test) -->
		<add name="MySqlMultiR_Produccio"
			 connectionString="Server=zeus;Database=marsa;Uid=marsa;Pwd=2a0d9a8d22;"
			 providerName="MySql.Data.MySqlClient" />

		<!-- ============================================ -->
		<!-- ENTORN PREPRODUCCIÓ -->
		<!-- ============================================ -->

		<!-- Oracle Modulab Connection - Preproducció -->
		<add name="OracleModulab_Preproduccio"
			 connectionString="Data source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL = TCP)(HOST = 146.219.109.73)(PORT = 1521))) (CONNECT_DATA = (SERVICE_NAME = mgold)));User Id=covid;Password=t6k8*_NQueB6;"
			 providerName="Oracle.ManagedDataAccess.Client" />

		<!-- MySQL MultiR Connection - Preproducció -->
		<add name="MySqlMultiR_Preproduccio"
			 connectionString="Server=zeus;Database=marsa_test;Uid=marsa;Pwd=2a0d9a8d22;"
			 providerName="MySql.Data.MySqlClient" />
	</connectionStrings>


	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<!-- Binding redirects si son necessaris -->
		</assemblyBinding>
	</runtime>
</configuration>
