<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Pots canviar la versió segons el framework que usis -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>MultirIntegraModulab</RootNamespace>
    <AssemblyName>MultirIntegraModulab</AssemblyName>
    
    <!-- ✅ CLEAN ARCHITECTURE com a punt d'entrada -->
    <!-- Canviat de Program (legacy) a ProgramCleanArchitecture -->
    <StartupObject>MultirIntegraModulab.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Paquet NuGet d'Oracle i MySQL -->
    <PackageReference Include="MySql.Data" Version="9.4.0" />
    <PackageReference Include="Oracle.ManagedDataAccess" Version="19.23.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referència a System.Web per HttpUtility -->
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <!-- ❌ Excloure la carpeta _Legacy de la compilació -->
    <Compile Remove="_Legacy\**" />
    <EmbeddedResource Remove="_Legacy\**" />
    <None Remove="_Legacy\**" />
  </ItemGroup>

</Project>